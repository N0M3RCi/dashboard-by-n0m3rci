# ─────────────────────────────────────────────────────────────────────────────
# This dashboard pulls live + historical BOT DATA (metrics, subscribers, commands,
# message logs, token usage estimates) from Telegram using your bot token + events
# pushed by your bot to this server's /api/events/report endpoint.
#
# For permanence (no lost data on redeploy/restart):
#   1. Set TELEGRAM_BOT_TOKEN below (MUST) or as Railway service Variable
#   2. Attach a persistent VOLUME (mount /app/storage recommended) on Railway
# The persisted storage/ + env vars + UI save ensure credentials + all analytics history
# survive restarts without re-entry or manual seeding.
# ─────────────────────────────────────────────────────────────────────────────

# Your live Telegram Bot token (from BotFather).
# The dashboard will pull data using this key. It is ALSO accepted by the bot itself.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API server port (default: 3001) — only relevant for local dev of the API
API_PORT=3001
